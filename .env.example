# ── BudgetKatta environment ──────────────────────────────
# Copy this file to .env.local and fill in values.
# Everything is OPTIONAL for local dev — the app runs with sample data,
# a rule-based chatbot, an animated fallback bot, console-logged leads,
# and "coming soon" voice when these are left blank.

# ── Database ────────────────────────────────────────────
# MongoDB Atlas connection string (server-side only — keep secret).
# When set, run `npm run seed` to load demo data; the site then serves DB data.
MONGODB_URI=

# ── n8n lead automation ─────────────────────────────────
# Server-side webhook used by /api/leads (preferred — kept out of the browser).
N8N_WEBHOOK_URL=
# Public webhook used by lightweight client events (e.g. bot quick actions).
# If N8N_WEBHOOK_URL is unset, /api/leads falls back to this one.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# ── Gemini chatbot ──────────────────────────────────────
# Google Gemini API key (server-side only — keep secret).
# When unset, the bot uses a rule-based finance fallback.
GEMINI_API_KEY=

# ── Vapi voice assistant ────────────────────────────────
# Must be NEXT_PUBLIC_ so the client can detect it and start a call.
# When unset, the voice button shows a bilingual "coming soon" message.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ── Spline 3D robot ─────────────────────────────────────
# Scene URL for the desktop bot, e.g.
# https://prod.spline.design/XXXXXXXX/scene.splinecode
# When unset, a premium animated fallback robot is shown.
NEXT_PUBLIC_SPLINE_SCENE_URL=

# ── Contact ─────────────────────────────────────────────
# Public contact email shown across the site. Falls back to hello@budgetkatta.in.
NEXT_PUBLIC_CONTACT_EMAIL=hello@budgetkatta.in

# ── Contact / WhatsApp ──────────────────────────────────
# WhatsApp number in international format without "+" (e.g. 919876543210).
# When set, the Contact page shows a WhatsApp CTA; otherwise "coming soon".
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Admin placeholder ───────────────────────────────────
# Set to "true" to enable the /admin overview page.
NEXT_PUBLIC_ENABLE_ADMIN=

# ── Affiliate links ─────────────────────────────────────
# Real referral / affiliate URLs for the promo banners. When unset, the banner
# shows a disabled "Coming soon" CTA instead of a dead link.
NEXT_PUBLIC_AFF_DEMAT=
NEXT_PUBLIC_AFF_CREDIT_CARD=
NEXT_PUBLIC_AFF_LOAN=
NEXT_PUBLIC_AFF_INSURANCE=
# Women business-loan partners (e.g. Bajaj Finserv, Tata Capital) — shown on /loans/women.
NEXT_PUBLIC_AFF_WOMEN_LOAN=
# Women business-loan comparison widget (/loans/women). Aggregator = single
# Paisabazaar/BankBazaar business-loan link covering many lenders (recommended
# first step); per-lender vars override it. Fallback: lender's official site.
NEXT_PUBLIC_AFF_WOMEN_AGGREGATOR=
NEXT_PUBLIC_AFF_LENDER_BAJAJ=
NEXT_PUBLIC_AFF_LENDER_TATACAP=
NEXT_PUBLIC_AFF_LENDER_LENDINGKART=
# "Personal loan for education" widget (/loans/students/personal-loan). Most
# affiliate-available campaigns (Paisabazaar / Ruloans / BankBazaar personal
# loan). Aggregator powers the "compare all" CTA; per-lender vars override it.
NEXT_PUBLIC_AFF_PL_AGGREGATOR=
NEXT_PUBLIC_AFF_LENDER_BAJAJ_PL=
NEXT_PUBLIC_AFF_LENDER_TATACAP_PL=
NEXT_PUBLIC_AFF_LENDER_MONEYVIEW=
# Education-loan partners (e.g. Credila, Avanse, InCred via Cuelinks/INRDeals) — shown on /loans/students.
NEXT_PUBLIC_AFF_EDU_LOAN=
# RECOMMENDED FIRST STEP: a single aggregator referral link (Paisabazaar /
# BankBazaar) covering SBI + many private lenders. When set, it powers the
# "compare all" CTA and is the fallback for any lender without its own link.
NEXT_PUBLIC_AFF_EDU_AGGREGATOR=
# Per-lender "Apply" links for the education-loan comparison widget on /loans/students.
# Priority: this var -> aggregator link -> the lender's official site.
NEXT_PUBLIC_AFF_LENDER_CREDILA=
NEXT_PUBLIC_AFF_LENDER_AVANSE=
NEXT_PUBLIC_AFF_LENDER_INCRED=
NEXT_PUBLIC_AFF_LENDER_SBI_EDU=
# Amazon Associates tracking tag (e.g. budgetkatta-21). Appended to amazon.in
# product URLs via withAmazonTag(). Required to earn Amazon commissions.
NEXT_PUBLIC_AMAZON_TAG=
# Broker referral links for the "Demat & Investing App Offers" section.
# When unset, the card links to the broker's official site.
NEXT_PUBLIC_AFF_ZERODHA=
NEXT_PUBLIC_AFF_UPSTOX=
NEXT_PUBLIC_AFF_ANGELONE=
NEXT_PUBLIC_AFF_GROWW=
# Credit-card referral links for the "Credit Card Offers" section.
# When unset, the card links to the issuer's official site.
# Credit-card referral links — naming pattern: NEXT_PUBLIC_AFF_<BANK>_CC
NEXT_PUBLIC_AFF_HDFC_CC=
NEXT_PUBLIC_AFF_SBI_CC=
NEXT_PUBLIC_AFF_AXIS_CC=
NEXT_PUBLIC_AFF_YES_CC=
NEXT_PUBLIC_AFF_BOB_CC=
NEXT_PUBLIC_AFF_AMEX_CC=
NEXT_PUBLIC_AFF_AU_BANK=

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ════════════════════════════════════════════════════════
# Sprint 1 · FOUNDATION (auth, memory, analytics, security)
# Same philosophy: OPTIONAL for local dev. Without these, auth runs in
# dev mode (OTP printed to the server console, no SMS), analytics stay off,
# and rate-limiting falls back to in-memory. Fill them to go production.
# ════════════════════════════════════════════════════════

# ── Auth.js (session signing) ───────────────────────────
# Generate with: openssl rand -base64 32   (server-side secret)
AUTH_SECRET=
# Canonical site URL for OAuth callbacks (prod: https://www.budgetkatta.in)
AUTH_URL=http://localhost:3000

# ── Google Sign-In (OAuth) ──────────────────────────────
# From Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Phone OTP (MSG91) ───────────────────────────────────
# India-optimized SMS OTP. When unset, OTPs are printed to the server
# console in dev instead of being texted (so the flow is fully testable).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ── Upstash Redis (OTP store + rate limiting) ───────────
# Serverless-safe shared store. Fixes the in-memory limiter (audit finding).
# REQUIRED in production: the OTP flow refuses to run in prod without it
# (the in-memory fallback is per-instance/non-durable and dev-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-IP OTP-request limit (per minute). Default 5. Raise for shared/NAT IPs.
OTP_IP_LIMIT_PER_MIN=

# ── PII encryption ──────────────────────────────────────
# 32-byte key (base64) for field-level encryption of financial PII at rest.
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── Admin API token (was undocumented — audit fix) ──────
# Required to authorize writes to /api/rates. When unset, those writes are
# DENIED (fail-closed) rather than falling back to the public admin flag.
ADMIN_API_TOKEN=

# ── Analytics (consent-gated; loaded only after cookie consent) ──
# GA4 measurement id (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity project id
NEXT_PUBLIC_CLARITY_ID=
# Meta (Facebook) Pixel id
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API token (server-side, for CAPI via n8n)
META_CAPI_TOKEN=
